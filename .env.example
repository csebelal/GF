# MongoDB Connection String (e.g. mongodb://127.0.0.1:27017/afrin_portfolio or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/afrin_portfolio

# 32+ character cryptographic secret for signing admin JWT sessions
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_a_secure_random_32_character_string_minimum

# Initial Admin Credentials (used by scripts/seed-mongo.ts)
DEFAULT_ADMIN_EMAIL=admin@portfolio.local
DEFAULT_ADMIN_PASSWORD=ReplaceWithStrongPassword123!

# Public Website URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
